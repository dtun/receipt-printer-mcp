{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "receipt-printer",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "PrinterHub" }]
  },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["printer@kitkit.dev"] }],
  "vars": { "EMAIL_FROM": "printer@kitkit.dev" },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrinterHub"] }],
  "observability": { "enabled": true }
}
